# Copy to backend/.env (or the repo-root .env) and fill in. Real environment
# variables (e.g. on Render) always win over this file.
DATABASE_URL=sqlite:///./cinematch.db        # prod: Postgres URL (Neon / Supabase / Render)
JWT_SECRET=change-me                         # use a long random string in production
ADMIN_EMAILS=you@example.com                 # comma-separated; the first registered user is admin too
OPENWEATHER_API_KEY=                         # optional: live weather on the home page
CORS_ORIGINS=*                               # prod: your frontend URL
ARTIFACTS_DIR=./artifacts                    # relative paths are relative to backend/
ENABLE_INAPP_RETRAIN=false
# BCRYPT_ROUNDS=12                           # optional, tests use 4 to run fast
